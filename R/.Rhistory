# ---- build ------------------------------------------------------------
for (nm in names(arms)) {
a <- arms[[nm]]
s <- base
if (a$nets) {
s[net_line] <- gsub('repeatEnd="2026-01-01"',
'repeatEnd="2046-01-01"', s[net_line])
}
if (a$wolb) {
# deployment first (later line), then component - so the earlier
# insertion doesn't shift the line number of the later one
s <- append(s, wolb_deployment, after = human_end - 1)
s <- append(s, wolb_component,  after = dep_start - 1)
}
writeLines(s, file.path("arms2", paste0(nm, ".xml")))
}
for (nm in names(arms)) {
f <- readLines(file.path("arms2", paste0(nm, ".xml")), warn = FALSE)
cat(sprintf("%-15s nets to %s   blocking: %s\n", nm,
sub('.*repeatEnd="([^"]+)".*', '\\1', grep('repeatStep="3y"', f, value=TRUE)),
any(grepl("wolb_blocking", f))))
}
library(data.table)
library(ggplot2)
setwd("C:/Users/LakshminarayananPree/OneDrive - London School of Hygiene and Tropical Medicine/Desktop/PhD/Chapter 3/openMalaria-windows")
arms <- c("counterfactual","comparator","wolbachia","both")
series <- function(a, dir) {
d <- fread(file.path(dir, paste0("out_", a, ".txt")),
col.names = c("survey","ageGroup","measure","value"))[survey > 1]
d[, year := 2000 + (survey - 1) * 5 / 365.25]
w <- d[ageGroup %in% c(4,5) & measure %in% c(0,3),
.(v = sum(value)), by = .(yr = floor(year), measure)]
w <- dcast(w, yr ~ measure, value.var = "v")
data.table(yr = w$yr, PfPR = 100 * w$`3` / w$`0`, arm = a)
}
rep <- rbindlist(lapply(arms, series, dir = "arms2"))
labs <- c(counterfactual = "Neither",
comparator     = "Nets only",
wolbachia      = "Blocking only",
both           = "Both")
rep[, arm := factor(labs[arm], levels = labs)]
ggplot(rep[yr >= 2015 & yr <= 2045], aes(yr, PfPR, colour = arm)) +
geom_line(linewidth = 0.9) +
geom_vline(xintercept = 2025, linetype = "dashed", colour = "grey55") +
scale_y_continuous(limits = c(0, 80), breaks = seq(0, 80, 10), expand = c(0,0)) +
scale_colour_manual(values = c("Neither" = "#4A7BA7", "Nets only" = "#97BC62",
"Blocking only" = "#B85042", "Both" = "#2C5F2D")) +
labs(x = NULL, y = "PfPR 2-10 (%)", colour = NULL,
title = "Population replacement in the An. moucheti archetype",
subtitle = "Transmission blocking at 80% efficacy, frequency rising to 96% by 2029") +
theme_minimal(base_size = 12) +
theme(legend.position = "top", panel.grid.minor = element_blank())
ggsave("replacement_arms.png", width = 8, height = 4.5, dpi = 300)
cases <- function(a, dir) {
d <- fread(file.path(dir, paste0("out_", a, ".txt")),
col.names = c("survey","ageGroup","measure","value"))[survey > 1]
d[, year := 2000 + (survey - 1) * 5 / 365.25]
d[year >= 2026 & year < 2046 & measure == 14, sum(value)]
}
ep <- sapply(arms, cases, dir = "arms2")
g <- ep["counterfactual"] - ep["comparator"]
w <- ep["counterfactual"] - ep["wolbachia"]
b <- ep["counterfactual"] - ep["both"]
print(data.frame(arm = arms, episodes = round(ep),
averted = round(ep["counterfactual"] - ep),
pct = round(100*(ep["counterfactual"] - ep)/ep["counterfactual"], 1)))
cat(sprintf("\nnets alone     %.0f\nblocking alone %.0f\nsum            %.0f\nboth           %.0f\nratio          %.2f\n",
g, w, g + w, b, b/(g+w)))
sup <- rbindlist(lapply(arms, series, dir = "arms"))
sup[, strategy := "Suppression"]; rep2 <- copy(rep); rep2[, strategy := "Replacement"]
sup[, arm := factor(labs[arm], levels = labs)]
comp <- rbind(sup, rep2)
ggplot(comp[yr >= 2015 & yr <= 2045 & arm %in% c("Blocking only","Both")],
aes(yr, PfPR, colour = arm, linetype = strategy)) +
geom_line(linewidth = 0.9) +
geom_vline(xintercept = 2025, linetype = "dashed", colour = "grey55") +
scale_y_continuous(limits = c(0, 80), breaks = seq(0, 80, 10), expand = c(0,0)) +
labs(x = NULL, y = "PfPR 2-10 (%)", colour = NULL, linetype = NULL,
title = "Suppression vs replacement, same archetype") +
theme_minimal(base_size = 12) +
theme(legend.position = "top", panel.grid.minor = element_blank())
