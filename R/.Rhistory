# Shiny app for Trial 1b: Epidemiological evaluation
# Additive scoring: each parameter scored 1-3, sum determines tier (T1=3-4, T2=5-7, T3=8-9)
library(shiny)
library(terra)
library(sf)
library(plotly)
data_dir <- "data"
paths <- list(
ara  = file.path(data_dir, "An_arabiensis.tif"),
col  = file.path(data_dir, "An_coluzzii.tif"),
mou  = file.path(data_dir, "An_moucheti.tif"),
gam  = file.path(data_dir, "An_gambiae.tif"),
ste  = file.path(data_dir, "An_stephensi.tif"),
pfpr = file.path(data_dir, "PfPR_mean.tif"),
itn  = file.path(data_dir, "ITN_use_rate.tif"),
inc  = file.path(data_dir, "Pf_Incidence_mean_2000.tif"),
pop  = file.path(data_dir, "POP_MEAN_2000_2020_5km.tif"),
gadm = file.path(data_dir, "gadm_ssa.gpkg")
)
to01 <- function(r) {
mx <- suppressWarnings(as.numeric(global(r, "max", na.rm = TRUE)))
r1 <- if (is.finite(mx) && mx > 1) r / 100 else r
clamp(r1, 0, 1, values = TRUE)
}
safe_div <- function(num, den, eps = 1e-9) num / (den + eps)
fast_align <- function(r, template, method = "bilinear") {
if (!identical(crs(r), crs(template))) project(r, template, method = method)
else resample(r, template, method = method)
}
cat("Loading data...\n")
# sub-Saharan Africa countries used for analysis; all Africa shown for context
ssa_iso <- c(
"AGO","BEN","BWA","BFA","BDI","CPV","CMR","CAF","TCD","COM","COG","CIV","COD","GNQ","ERI",
"SWZ","ETH","GAB","GMB","GHA","GIN","GNB","KEN","LSO","LBR","MDG","MWI","MLI","MRT","MUS","MOZ",
"NAM","NER","NGA","RWA","STP","SEN","SYC","SLE","ZAF","SSD","TGO","UGA","TZA","ZMB","ZWE",
"SDN","SOM","DJI"
)
# All African ISO3 codes — for display extent only
africa_iso <- c(
ssa_iso,
# North Africa (not in sub-Saharan Africa)
"MAR","TUN","LBY","EGY","DZA","SDN","SOM","DJI","ERI"
)
# Remove duplicates (ERI, SOM, DJI already in ssa_iso)
africa_iso <- unique(africa_iso)
a0       <- st_read(paths$gadm, layer = "ADM_0", quiet = TRUE)
a1       <- st_read(paths$gadm, layer = "ADM_1", quiet = TRUE)
# Analysis boundary — sub-Saharan Africa only
ADMIN0   <- vect(a0[a0$GID_0 %in% ssa_iso, ])
ADMIN1   <- vect(a1[a1$GID_0 %in% ssa_iso, ])
# Named vector: country name -> ISO code for zoom dropdown
afro_sf       <- a0[a0$GID_0 %in% ssa_iso, ]
name_col      <- if ("COUNTRY" %in% names(afro_sf)) "COUNTRY" else "NAME_0"
COUNTRY_CHOICES <- c("None (full Africa)" = "",
setNames(sort(afro_sf$GID_0),
afro_sf[[name_col]][order(afro_sf$GID_0)]))
# Display boundary — all Africa (for map background context)
AFRICA0  <- vect(a0[a0$GID_0 %in% africa_iso, ])
AFRICA1  <- vect(a1[a1$GID_0 %in% africa_iso, ])
PFPR_MEAN <- rast(paths$pfpr)
ADMIN0_P  <- if (!identical(crs(ADMIN0), crs(PFPR_MEAN))) project(ADMIN0, crs(PFPR_MEAN)) else ADMIN0
TEMPLATE  <- crop(PFPR_MEAN, ADMIN0_P, snap = "out")
ADMIN0_A  <- if (!identical(crs(ADMIN0), crs(TEMPLATE))) project(ADMIN0, crs(TEMPLATE)) else ADMIN0
ADMIN1_A  <- if (!identical(crs(ADMIN1), crs(TEMPLATE))) project(ADMIN1, crs(TEMPLATE)) else ADMIN1
AFRICA0_A <- if (!identical(crs(AFRICA0), crs(TEMPLATE))) project(AFRICA0, crs(TEMPLATE)) else AFRICA0
AFRICA1_A <- if (!identical(crs(AFRICA1), crs(TEMPLATE))) project(AFRICA1, crs(TEMPLATE)) else AFRICA1
PFPR_ALIGNED <- to01(fast_align(PFPR_MEAN, TEMPLATE))
ITN_ALIGNED  <- to01(fast_align(rast(paths$itn), TEMPLATE))
INC_ALIGNED  <- fast_align(rast(paths$inc), TEMPLATE)
POP_ALIGNED  <- fast_align(rast(paths$pop), TEMPLATE)
BURDEN_GLOBAL <- POP_ALIGNED * INC_ALIGNED
CELL_AREA_KM2 <- cellSize(TEMPLATE, unit = "km")
species_rasters <- list(
arabiensis = rast(paths$ara),
coluzzii   = rast(paths$col),
moucheti   = rast(paths$mou),
gambiae    = rast(paths$gam),
stephensi  = rast(paths$ste)
)
SPECIES_ALIGNED <- lapply(species_rasters, function(r) fast_align(to01(r), TEMPLATE))
cat("Data loaded.\n")
# ITN tier: < 60% = T1, 60-80% = T2, >= 80% = T3
itn_breaks <- c(-Inf, 0.60, 0.80, Inf)
# PfPR tier UC1b reversed: >= 40% = T1, 15-40% = T2, < 15% = T3
pfpr_breaks <- c(-Inf, 0.15, 0.40, Inf)
# ============================================================
# Trial 1b: An. arabiensis — Tier 1 cells that are exactly 1,1,1
# ============================================================
sp <- "arabiensis"
# --- 1. Calculate vector dominance ---
base_p <- SPECIES_ALIGNED[[sp]]
base_p0 <- base_p
base_p0[is.na(base_p0)] <- 0
others <- rast(
lapply(
setdiff(names(SPECIES_ALIGNED), sp),
function(nm) {
r <- SPECIES_ALIGNED[[nm]]
r[is.na(r)] <- 0
r
}
)
)
dom <- safe_div(base_p0, base_p0 + app(others, sum))
# --- 2. Define default Trial 1b thresholds ---
dom_t1  <- 0.70   # Score 1: dominance >= 70%
itn_t1  <- 0.60   # Score 1: ITN < 60%
pfpr_t1 <- 0.40   # Score 1: PfPR >= 40%
# Species presence/data eligibility mask
valid <- !is.na(PFPR_ALIGNED) &
!is.na(ITN_ALIGNED) &
!is.na(base_p) &
base_p >= 0.10
# --- 3. Identify cells scoring exactly 1 on each parameter ---
dom_111 <- valid & dom >= dom_t1
itn_111 <- valid & ITN_ALIGNED < itn_t1
pfpr_111 <- valid & PFPR_ALIGNED >= pfpr_t1
# Cells where all three parameters score 1
all_111 <- dom_111 & itn_111 & pfpr_111
# --- 4. Create raster of 1,1,1 cells ---
r_111 <- rast(TEMPLATE)
values(r_111) <- NA
r_111[all_111] <- 1
# Restrict to sub-Saharan Africa
r_111 <- mask(r_111, ADMIN0_A)
# --- 5. Calculate area ---
CELL_AREA_KM2 <- cellSize(TEMPLATE, unit = "km")
area_111 <- global(
mask(CELL_AREA_KM2, r_111),
"sum",
na.rm = TRUE
)[1,1]
# --- 6. Count cells ---
n_cells_111 <- sum(!is.na(values(r_111)))
cat("An. arabiensis cells scoring 1,1,1:", n_cells_111, "\n")
cat("Area scoring 1,1,1:", round(area_111), "km2\n")
# Total score
score <-
ifel(valid & dom >= dom_t1, 1,
ifel(valid & dom >= 0.40, 2, 3)) +
ifel(valid & ITN_ALIGNED < itn_t1, 1,
ifel(valid & ITN_ALIGNED < 0.80, 2, 3)) +
ifel(valid & PFPR_ALIGNED >= pfpr_t1, 1,
ifel(valid & PFPR_ALIGNED >= 0.15, 2, 3))
# All Tier 1 cells = total score 3 or 4
tier1 <- valid & score >= 3 & score <= 4
# Exactly 1,1,1 = score 3
exact_111 <- valid &
dom >= dom_t1 &
ITN_ALIGNED < itn_t1 &
PFPR_ALIGNED >= pfpr_t1
# Areas
area_tier1 <- global(
mask(CELL_AREA_KM2, ifel(tier1, 1, NA)),
"sum", na.rm = TRUE
)[1,1]
area_111 <- global(
mask(CELL_AREA_KM2, ifel(exact_111, 1, NA)),
"sum", na.rm = TRUE
)[1,1]
cat("Total Tier 1 area:", round(area_tier1), "km2\n")
cat("Exact 1,1,1 area:", round(area_111), "km2\n")
cat("Proportion of Tier 1 that is 1,1,1:",
round(100 * area_111 / area_tier1, 1), "%\n")
# ============================================================
# An. arabiensis — composition of Tier 1
# ============================================================
sp <- "arabiensis"
# Vector dominance
base_p <- SPECIES_ALIGNED[[sp]]
base_p0 <- base_p
base_p0[is.na(base_p0)] <- 0
others <- rast(
lapply(
setdiff(names(SPECIES_ALIGNED), sp),
function(nm) {
r <- SPECIES_ALIGNED[[nm]]
r[is.na(r)] <- 0
r
}
)
)
dom <- safe_div(base_p0, base_p0 + app(others, sum))
# Default thresholds
dom_t1  <- 0.70
dom_t2  <- 0.40
itn_t1  <- 0.60
itn_t2  <- 0.80
pfpr_t1 <- 0.40
pfpr_t2 <- 0.15
# Valid cells
valid <- !is.na(PFPR_ALIGNED) &
!is.na(ITN_ALIGNED) &
!is.na(base_p) &
base_p >= 0.10
# ------------------------------------------------------------
# Score each parameter 1–3
# ------------------------------------------------------------
dom_score <- ifel(valid & dom >= dom_t1, 1,
ifel(valid & dom >= dom_t2, 2,
ifel(valid, 3, NA)))
itn_score <- ifel(valid & ITN_ALIGNED < itn_t1, 1,
ifel(valid & ITN_ALIGNED < itn_t2, 2,
ifel(valid, 3, NA)))
pfpr_score <- ifel(valid & PFPR_ALIGNED >= pfpr_t1, 1,
ifel(valid & PFPR_ALIGNED >= pfpr_t2, 2,
ifel(valid, 3, NA)))
# ------------------------------------------------------------
# Count every possible Tier 1 combination
# ------------------------------------------------------------
comb_111 <- valid &
dom_score == 1 & itn_score == 1 & pfpr_score == 1
comb_112 <- valid &
dom_score == 1 & itn_score == 1 & pfpr_score == 2
comb_121 <- valid &
dom_score == 1 & itn_score == 2 & pfpr_score == 1
comb_211 <- valid &
dom_score == 2 & itn_score == 1 & pfpr_score == 1
# ------------------------------------------------------------
# Count cells
# ------------------------------------------------------------
n111 <- sum(values(comb_111), na.rm = TRUE)
n112 <- sum(values(comb_112), na.rm = TRUE)
n121 <- sum(values(comb_121), na.rm = TRUE)
n211 <- sum(values(comb_211), na.rm = TRUE)
total_tier1 <- n111 + n112 + n121 + n211
cat("\nAn. arabiensis — Tier 1 composition\n")
cat("-----------------------------------\n")
cat("1,1,1:", n111, "cells\n")
cat("1,1,2:", n112, "cells\n")
cat("1,2,1:", n121, "cells\n")
cat("2,1,1:", n211, "cells\n")
cat("-----------------------------------\n")
cat("Total Tier 1:", total_tier1, "cells\n")
area111 <- global(mask(CELL_AREA_KM2, ifel(comb_111, 1, NA)),
"sum", na.rm = TRUE)[1,1]
area112 <- global(mask(CELL_AREA_KM2, ifel(comb_112, 1, NA)),
"sum", na.rm = TRUE)[1,1]
area121 <- global(mask(CELL_AREA_KM2, ifel(comb_121, 1, NA)),
"sum", na.rm = TRUE)[1,1]
area211 <- global(mask(CELL_AREA_KM2, ifel(comb_211, 1, NA)),
"sum", na.rm = TRUE)[1,1]
total_area_tier1 <- area111 + area112 + area121 + area211
cat("\nArea (km2)\n")
cat("1,1,1:", round(area111), "\n")
cat("1,1,2:", round(area112), "\n")
cat("1,2,1:", round(area121), "\n")
cat("2,1,1:", round(area211), "\n")
cat("Total Tier 1:", round(total_area_tier1), "\n")
