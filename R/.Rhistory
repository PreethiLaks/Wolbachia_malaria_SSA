a1 <- st_read(file.path(data_dir, "gadm_ssa.gpkg"), layer = "ADM_1", quiet = TRUE)
# Fix invalid geometries
a0 <- st_make_valid(a0)
a1 <- st_make_valid(a1)
# Simplify geometry to reduce memory
a0 <- st_simplify(a0, dTolerance = 0.01, preserveTopology = TRUE)
a1 <- st_simplify(a1, dTolerance = 0.01, preserveTopology = TRUE)
ADMIN0  <- vect(a0[a0$GID_0 %in% ssa_iso, ])
ADMIN1  <- vect(a1[a1$GID_0 %in% ssa_iso, ])
AFRICA0 <- vect(a0[a0$GID_0 %in% africa_iso, ])
AFRICA1 <- vect(a1[a1$GID_0 %in% africa_iso, ])
# Build country choices for zoom dropdown
afro_sf  <- a0[a0$GID_0 %in% ssa_iso, ]
name_col <- if ("COUNTRY" %in% names(afro_sf)) "COUNTRY" else "NAME_0"
COUNTRY_CHOICES <- c("None (full Africa)" = "",
setNames(sort(afro_sf$GID_0),
afro_sf[[name_col]][order(afro_sf$GID_0)]))
# ── Step 2: Align rasters to common template ─────────────────
cat("Step 2: Aligning rasters...\n")
PFPR_MEAN <- rast(file.path(data_dir, "PfPR_mean.tif"))
ADMIN0_P  <- if (!identical(crs(ADMIN0), crs(PFPR_MEAN))) project(ADMIN0, crs(PFPR_MEAN)) else ADMIN0
TEMPLATE  <- crop(PFPR_MEAN, ADMIN0_P, snap = "out")
ADMIN0_A  <- if (!identical(crs(ADMIN0),  crs(TEMPLATE))) project(ADMIN0,  crs(TEMPLATE)) else ADMIN0
ADMIN1_A  <- if (!identical(crs(ADMIN1),  crs(TEMPLATE))) project(ADMIN1,  crs(TEMPLATE)) else ADMIN1
AFRICA0_A <- if (!identical(crs(AFRICA0), crs(TEMPLATE))) project(AFRICA0, crs(TEMPLATE)) else AFRICA0
AFRICA1_A <- if (!identical(crs(AFRICA1), crs(TEMPLATE))) project(AFRICA1, crs(TEMPLATE)) else AFRICA1
PFPR_ALIGNED <- to01(fast_align(PFPR_MEAN, TEMPLATE))
ITN_ALIGNED  <- to01(fast_align(rast(file.path(data_dir, "ITN_use_rate.tif")), TEMPLATE))
INC_ALIGNED  <- fast_align(rast(file.path(data_dir, "Pf_Incidence_mean_2000.tif")), TEMPLATE)
POP_ALIGNED  <- fast_align(rast(file.path(data_dir, "POP_MEAN_2000_2020_5km.tif")), TEMPLATE)
BURDEN_GLOBAL <- POP_ALIGNED * INC_ALIGNED
CELL_AREA_KM2 <- cellSize(TEMPLATE, unit = "km")
# Aligned species rasters
sp_files <- list(
arabiensis = "An_arabiensis.tif",
coluzzii   = "An_coluzzii.tif",
moucheti   = "An_moucheti.tif",
gambiae    = "An_gambiae.tif",
stephensi  = "An_stephensi.tif"
)
SPECIES_ALIGNED <- lapply(sp_files, function(f) {
fast_align(to01(rast(file.path(data_dir, f))), TEMPLATE)
})
sp_names <- c("arabiensis","coluzzii","moucheti","gambiae")
# ── Step 3: Save processed boundaries as RDS ─────────────────
cat("Step 3: Saving boundaries...\n")
# Save as sf objects — terra vect objects cannot be saved to RDS
saveRDS(list(
ADMIN0_sf       = st_as_sf(ADMIN0),
ADMIN1_sf       = st_as_sf(ADMIN1),
AFRICA0_sf      = st_as_sf(AFRICA0),
AFRICA1_sf      = st_as_sf(AFRICA1),
COUNTRY_CHOICES = COUNTRY_CHOICES,
afro_sf         = afro_sf
), file.path(data_dir, "boundaries.rds"))
cat("  Saved: boundaries.rds\n")
# ── Step 4: Save aligned rasters ─────────────────────────────
cat("Step 4: Saving aligned rasters...\n")
writeRaster(PFPR_ALIGNED,  file.path(data_dir, "pfpr_aligned.tif"),   overwrite=TRUE)
writeRaster(ITN_ALIGNED,   file.path(data_dir, "itn_aligned.tif"),    overwrite=TRUE)
writeRaster(BURDEN_GLOBAL, file.path(data_dir, "burden_aligned.tif"), overwrite=TRUE)
writeRaster(CELL_AREA_KM2, file.path(data_dir, "cell_area_km2.tif"),  overwrite=TRUE)
for (sp in names(SPECIES_ALIGNED)) {
writeRaster(SPECIES_ALIGNED[[sp]],
file.path(data_dir, paste0(sp, "_aligned.tif")),
overwrite = TRUE)
cat("  Saved:", sp, "_aligned.tif\n")
}
# ── Step 5: Pre-compute tier rasters for all use cases ───────
cat("Step 5: Pre-computing tier rasters...\n")
compute_dom <- function(sp) {
base_p0 <- SPECIES_ALIGNED[[sp]]; base_p0[is.na(base_p0)] <- 0
others  <- rast(lapply(setdiff(sp_names, sp), function(nm) {
r <- SPECIES_ALIGNED[[nm]]; r[is.na(r)] <- 0; r
}))
safe_div(base_p0, base_p0 + app(others, sum))
}
compute_tier <- function(sp, dom_t1, dom_t2, itn_t1, itn_t2,
pfpr_t1, pfpr_t2, pfpr_high=FALSE,
pfpr_cap=NULL) {
dom       <- compute_dom(sp)
base_p    <- SPECIES_ALIGNED[[sp]]
if (!is.null(pfpr_cap)) {
data_mask <- ifel(!is.na(PFPR_ALIGNED) & PFPR_ALIGNED < pfpr_cap &
!is.na(ITN_ALIGNED) & !is.na(base_p) & base_p >= 0.10, 1, NA)
} else {
data_mask <- ifel(!is.na(PFPR_ALIGNED) & !is.na(ITN_ALIGNED) &
!is.na(base_p) & base_p >= 0.10, 1, NA)
}
dm_v    <- values(dom); valid_v <- values(data_mask)
itn_v   <- values(ITN_ALIGNED); pfpr_v <- values(PFPR_ALIGNED)
tv <- rep(NA_real_, length(dm_v))
tv[!is.na(valid_v) & !is.na(dm_v) & dm_v >= dom_t1] <- 1
tv[!is.na(valid_v) & !is.na(dm_v) & dm_v >= dom_t2 & dm_v < dom_t1] <- 2
tv[!is.na(valid_v) & !is.na(dm_v) & dm_v <  dom_t2] <- 3
ti <- rep(NA_real_, length(itn_v))
if (!pfpr_high) {
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v <  itn_t1] <- 1
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t1 & itn_v < itn_t2] <- 2
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t2] <- 3
} else {
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t1] <- 1
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t2 & itn_v < itn_t1] <- 2
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v <  itn_t2] <- 3
}
if (!is.null(pfpr_cap)) {
# UC3: 2-parameter scoring
sc  <- tv + ti
out <- rep(NA_real_, length(sc))
out[!is.na(sc) & sc <= 3] <- 1
out[!is.na(sc) & sc >= 4 & sc <= 5] <- 2
out[!is.na(sc) & sc == 6] <- 3
} else {
tp <- rep(NA_real_, length(pfpr_v))
if (!pfpr_high) {
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v <  pfpr_t1] <- 1
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t1 & pfpr_v < pfpr_t2] <- 2
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t2] <- 3
} else {
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t1] <- 1
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t2 & pfpr_v < pfpr_t1] <- 2
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v <  pfpr_t2] <- 3
}
sc  <- tv + ti + tp
out <- rep(NA_real_, length(sc))
out[!is.na(sc) & sc >= 3 & sc <= 4] <- 1
out[!is.na(sc) & sc >= 5 & sc <= 7] <- 2
out[!is.na(sc) & sc >= 8 & sc <= 9] <- 3
}
tier_r <- rast(TEMPLATE); values(tier_r) <- out
mask(tier_r, ADMIN0_A)
}
# UC1a: low PfPR = Score 1, low ITN = Score 1
cat("  UC1a...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.70, 0.40, 0.60, 0.80, 0.15, 0.40, pfpr_high=FALSE)
writeRaster(r, file.path(data_dir, paste0("tier_uc1a_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc1a_", sp, ".tif\n")
}
# UC1b: high PfPR = Score 1, low ITN = Score 1
cat("  UC1b...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.70, 0.40, 0.60, 0.80, 0.40, 0.15, pfpr_high=TRUE)
writeRaster(r, file.path(data_dir, paste0("tier_uc1b_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc1b_", sp, ".tif\n")
}
# UC2: high PfPR = Score 1, high ITN = Score 1
cat("  UC2...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.50, 0.25, 0.80, 0.60, 0.40, 0.15, pfpr_high=TRUE)
writeRaster(r, file.path(data_dir, paste0("tier_uc2_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc2_", sp, ".tif\n")
}
# UC3: PfPR < 5% hard filter, high ITN = Score 1, 2-parameter scoring
cat("  UC3...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.50, 0.25, 0.80, 0.60,
pfpr_t1=NULL, pfpr_t2=NULL,
pfpr_high=TRUE, pfpr_cap=0.05)
writeRaster(r, file.path(data_dir, paste0("tier_uc3_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc3_", sp, ".tif\n")
}
# ── Step 6: Save ELIM_AREA for UC3 ───────────────────────────
cat("Step 6: Saving UC3 elimination area...\n")
elim_mask  <- ifel(PFPR_ALIGNED < 0.05 & !is.na(POP_ALIGNED) & POP_ALIGNED > 1, 1, NA)
elim_mask  <- mask(elim_mask, ADMIN0_A)
ELIM_AREA  <- as.numeric(global(mask(CELL_AREA_KM2, elim_mask), "sum", na.rm=TRUE)[1,1])
saveRDS(ELIM_AREA, file.path(data_dir, "elim_area.rds"))
cat("  Saved: elim_area.rds\n")
# ── Step 7: Save global burden for UC2 ───────────────────────
cat("Step 7: Saving global burden...\n")
bur_mask  <- ifel(!is.na(INC_ALIGNED) & !is.na(POP_ALIGNED) &
POP_ALIGNED > 0 & INC_ALIGNED > 1e-12, 1, NA)
bur_valid  <- mask(BURDEN_GLOBAL, bur_mask)
bur_valid  <- mask(bur_valid, ADMIN0_A)
AFRO_BUR   <- as.numeric(global(bur_valid, "sum", na.rm=TRUE)[1,1])
saveRDS(AFRO_BUR, file.path(data_dir, "afro_burden.rds"))
cat("  Saved: afro_burden.rds\n")
cat("\n✓ All pre-processing complete!\n")
cat("New files in data/ folder:\n")
new_files <- c("boundaries.rds",
"pfpr_aligned.tif", "itn_aligned.tif",
"burden_aligned.tif", "cell_area_km2.tif",
paste0(sp_names, "_aligned.tif"),
paste0("tier_uc1a_", sp_names, ".tif"),
paste0("tier_uc1b_", sp_names, ".tif"),
paste0("tier_uc2_",  sp_names, ".tif"),
paste0("tier_uc3_",  sp_names, ".tif"),
"elim_area.rds", "afro_burden.rds")
cat(paste(" -", new_files, collapse="\n"), "\n")
cat("\nYou can now deploy the Shiny apps to shinyapps.io\n")
runApp('Demo_trial_1a.R')
View(ADMIN0_A)
# Delete old file
file.remove("data/boundaries.rds")
# Regenerate
source("run_once_prepare_data.R")
# run_once_prepare_data.R
# Run this script ONCE locally before deploying to shinyapps.io
# It pre-processes all raw data into lightweight files that the Shiny apps load directly
# Output files are saved to the data/ folder alongside this script
# Total output size: ~50MB vs ~500MB+ RAM when loading raw data in the app
library(terra)
library(sf)
sf_use_s2(FALSE)  # use planar geometry to avoid edge crossing errors
data_dir <- "data"
# ── Helper functions ──────────────────────────────────────────
to01 <- function(r) {
mx <- suppressWarnings(as.numeric(global(r, "max", na.rm = TRUE)))
r1 <- if (is.finite(mx) && mx > 1) r / 100 else r
clamp(r1, 0, 1, values = TRUE)
}
safe_div   <- function(num, den, eps = 1e-9) num / (den + eps)
fast_align <- function(r, template, method = "bilinear") {
if (!identical(crs(r), crs(template))) project(r, template, method = method)
else resample(r, template, method = method)
}
# ── Country lists ─────────────────────────────────────────────
ssa_iso <- c(
"AGO","BEN","BWA","BFA","BDI","CPV","CMR","CAF","TCD","COM","COG","CIV","COD","GNQ","ERI",
"SWZ","ETH","GAB","GMB","GHA","GIN","GNB","KEN","LSO","LBR","MDG","MWI","MLI","MRT","MUS","MOZ",
"NAM","NER","NGA","RWA","STP","SEN","SYC","SLE","ZAF","SSD","TGO","UGA","TZA","ZMB","ZWE",
"SDN","SOM","DJI"
)
africa_iso <- unique(c(ssa_iso, "MAR","TUN","LBY","EGY","DZA"))
# ── Step 1: Load and process boundaries ──────────────────────
cat("Step 1: Processing boundaries...\n")
a0 <- st_read(file.path(data_dir, "gadm_ssa.gpkg"), layer = "ADM_0", quiet = TRUE)
a1 <- st_read(file.path(data_dir, "gadm_ssa.gpkg"), layer = "ADM_1", quiet = TRUE)
# Fix invalid geometries
a0 <- st_make_valid(a0)
a1 <- st_make_valid(a1)
# Simplify geometry to reduce memory
a0 <- st_simplify(a0, dTolerance = 0.01, preserveTopology = TRUE)
a1 <- st_simplify(a1, dTolerance = 0.01, preserveTopology = TRUE)
ADMIN0  <- vect(a0[a0$GID_0 %in% ssa_iso, ])
ADMIN1  <- vect(a1[a1$GID_0 %in% ssa_iso, ])
AFRICA0 <- vect(a0[a0$GID_0 %in% africa_iso, ])
AFRICA1 <- vect(a1[a1$GID_0 %in% africa_iso, ])
# Build country choices for zoom dropdown
afro_sf  <- a0[a0$GID_0 %in% ssa_iso, ]
name_col <- if ("COUNTRY" %in% names(afro_sf)) "COUNTRY" else "NAME_0"
COUNTRY_CHOICES <- c("None (full Africa)" = "",
setNames(sort(afro_sf$GID_0),
afro_sf[[name_col]][order(afro_sf$GID_0)]))
# ── Step 2: Align rasters to common template ─────────────────
cat("Step 2: Aligning rasters...\n")
PFPR_MEAN <- rast(file.path(data_dir, "PfPR_mean.tif"))
ADMIN0_P  <- if (!identical(crs(ADMIN0), crs(PFPR_MEAN))) project(ADMIN0, crs(PFPR_MEAN)) else ADMIN0
TEMPLATE  <- crop(PFPR_MEAN, ADMIN0_P, snap = "out")
ADMIN0_A  <- if (!identical(crs(ADMIN0),  crs(TEMPLATE))) project(ADMIN0,  crs(TEMPLATE)) else ADMIN0
ADMIN1_A  <- if (!identical(crs(ADMIN1),  crs(TEMPLATE))) project(ADMIN1,  crs(TEMPLATE)) else ADMIN1
AFRICA0_A <- if (!identical(crs(AFRICA0), crs(TEMPLATE))) project(AFRICA0, crs(TEMPLATE)) else AFRICA0
AFRICA1_A <- if (!identical(crs(AFRICA1), crs(TEMPLATE))) project(AFRICA1, crs(TEMPLATE)) else AFRICA1
PFPR_ALIGNED <- to01(fast_align(PFPR_MEAN, TEMPLATE))
ITN_ALIGNED  <- to01(fast_align(rast(file.path(data_dir, "ITN_use_rate.tif")), TEMPLATE))
INC_ALIGNED  <- fast_align(rast(file.path(data_dir, "Pf_Incidence_mean_2000.tif")), TEMPLATE)
POP_ALIGNED  <- fast_align(rast(file.path(data_dir, "POP_MEAN_2000_2020_5km.tif")), TEMPLATE)
BURDEN_GLOBAL <- POP_ALIGNED * INC_ALIGNED
CELL_AREA_KM2 <- cellSize(TEMPLATE, unit = "km")
# Aligned species rasters
sp_files <- list(
arabiensis = "An_arabiensis.tif",
coluzzii   = "An_coluzzii.tif",
moucheti   = "An_moucheti.tif",
gambiae    = "An_gambiae.tif",
stephensi  = "An_stephensi.tif"
)
SPECIES_ALIGNED <- lapply(sp_files, function(f) {
fast_align(to01(rast(file.path(data_dir, f))), TEMPLATE)
})
sp_names <- c("arabiensis","coluzzii","moucheti","gambiae")
# ── Step 3: Save processed boundaries as RDS ─────────────────
cat("Step 3: Saving boundaries...\n")
# Save as sf objects — terra vect objects cannot be saved to RDS
saveRDS(list(
ADMIN0_sf       = st_as_sf(ADMIN0),
ADMIN1_sf       = st_as_sf(ADMIN1),
AFRICA0_sf      = st_as_sf(AFRICA0),
AFRICA1_sf      = st_as_sf(AFRICA1),
COUNTRY_CHOICES = COUNTRY_CHOICES,
afro_sf         = afro_sf
), file.path(data_dir, "boundaries.rds"))
cat("  Saved: boundaries.rds\n")
# ── Step 4: Save aligned rasters ─────────────────────────────
cat("Step 4: Saving aligned rasters...\n")
writeRaster(PFPR_ALIGNED,  file.path(data_dir, "pfpr_aligned.tif"),   overwrite=TRUE)
writeRaster(ITN_ALIGNED,   file.path(data_dir, "itn_aligned.tif"),    overwrite=TRUE)
writeRaster(BURDEN_GLOBAL, file.path(data_dir, "burden_aligned.tif"), overwrite=TRUE)
writeRaster(CELL_AREA_KM2, file.path(data_dir, "cell_area_km2.tif"),  overwrite=TRUE)
for (sp in names(SPECIES_ALIGNED)) {
writeRaster(SPECIES_ALIGNED[[sp]],
file.path(data_dir, paste0(sp, "_aligned.tif")),
overwrite = TRUE)
cat("  Saved:", sp, "_aligned.tif\n")
}
# ── Step 5: Pre-compute tier rasters for all use cases ───────
cat("Step 5: Pre-computing tier rasters...\n")
compute_dom <- function(sp) {
base_p0 <- SPECIES_ALIGNED[[sp]]; base_p0[is.na(base_p0)] <- 0
others  <- rast(lapply(setdiff(sp_names, sp), function(nm) {
r <- SPECIES_ALIGNED[[nm]]; r[is.na(r)] <- 0; r
}))
safe_div(base_p0, base_p0 + app(others, sum))
}
compute_tier <- function(sp, dom_t1, dom_t2, itn_t1, itn_t2,
pfpr_t1, pfpr_t2, pfpr_high=FALSE,
pfpr_cap=NULL) {
dom       <- compute_dom(sp)
base_p    <- SPECIES_ALIGNED[[sp]]
if (!is.null(pfpr_cap)) {
data_mask <- ifel(!is.na(PFPR_ALIGNED) & PFPR_ALIGNED < pfpr_cap &
!is.na(ITN_ALIGNED) & !is.na(base_p) & base_p >= 0.10, 1, NA)
} else {
data_mask <- ifel(!is.na(PFPR_ALIGNED) & !is.na(ITN_ALIGNED) &
!is.na(base_p) & base_p >= 0.10, 1, NA)
}
dm_v    <- values(dom); valid_v <- values(data_mask)
itn_v   <- values(ITN_ALIGNED); pfpr_v <- values(PFPR_ALIGNED)
tv <- rep(NA_real_, length(dm_v))
tv[!is.na(valid_v) & !is.na(dm_v) & dm_v >= dom_t1] <- 1
tv[!is.na(valid_v) & !is.na(dm_v) & dm_v >= dom_t2 & dm_v < dom_t1] <- 2
tv[!is.na(valid_v) & !is.na(dm_v) & dm_v <  dom_t2] <- 3
ti <- rep(NA_real_, length(itn_v))
if (!pfpr_high) {
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v <  itn_t1] <- 1
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t1 & itn_v < itn_t2] <- 2
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t2] <- 3
} else {
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t1] <- 1
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v >= itn_t2 & itn_v < itn_t1] <- 2
ti[!is.na(valid_v) & !is.na(itn_v) & itn_v <  itn_t2] <- 3
}
if (!is.null(pfpr_cap)) {
# UC3: 2-parameter scoring
sc  <- tv + ti
out <- rep(NA_real_, length(sc))
out[!is.na(sc) & sc <= 3] <- 1
out[!is.na(sc) & sc >= 4 & sc <= 5] <- 2
out[!is.na(sc) & sc == 6] <- 3
} else {
tp <- rep(NA_real_, length(pfpr_v))
if (!pfpr_high) {
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v <  pfpr_t1] <- 1
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t1 & pfpr_v < pfpr_t2] <- 2
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t2] <- 3
} else {
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t1] <- 1
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v >= pfpr_t2 & pfpr_v < pfpr_t1] <- 2
tp[!is.na(valid_v) & !is.na(pfpr_v) & pfpr_v <  pfpr_t2] <- 3
}
sc  <- tv + ti + tp
out <- rep(NA_real_, length(sc))
out[!is.na(sc) & sc >= 3 & sc <= 4] <- 1
out[!is.na(sc) & sc >= 5 & sc <= 7] <- 2
out[!is.na(sc) & sc >= 8 & sc <= 9] <- 3
}
tier_r <- rast(TEMPLATE); values(tier_r) <- out
mask(tier_r, ADMIN0_A)
}
# UC1a: low PfPR = Score 1, low ITN = Score 1
cat("  UC1a...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.70, 0.40, 0.60, 0.80, 0.15, 0.40, pfpr_high=FALSE)
writeRaster(r, file.path(data_dir, paste0("tier_uc1a_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc1a_", sp, ".tif\n")
}
# UC1b: high PfPR = Score 1, low ITN = Score 1
cat("  UC1b...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.70, 0.40, 0.60, 0.80, 0.40, 0.15, pfpr_high=TRUE)
writeRaster(r, file.path(data_dir, paste0("tier_uc1b_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc1b_", sp, ".tif\n")
}
# UC2: high PfPR = Score 1, high ITN = Score 1
cat("  UC2...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.50, 0.25, 0.80, 0.60, 0.40, 0.15, pfpr_high=TRUE)
writeRaster(r, file.path(data_dir, paste0("tier_uc2_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc2_", sp, ".tif\n")
}
# UC3: PfPR < 5% hard filter, high ITN = Score 1, 2-parameter scoring
cat("  UC3...\n")
for (sp in sp_names) {
r <- compute_tier(sp, 0.50, 0.25, 0.80, 0.60,
pfpr_t1=NULL, pfpr_t2=NULL,
pfpr_high=TRUE, pfpr_cap=0.05)
writeRaster(r, file.path(data_dir, paste0("tier_uc3_", sp, ".tif")),
overwrite=TRUE, datatype="INT1U")
cat("    Saved: tier_uc3_", sp, ".tif\n")
}
# ── Step 6: Save ELIM_AREA for UC3 ───────────────────────────
cat("Step 6: Saving UC3 elimination area...\n")
elim_mask  <- ifel(PFPR_ALIGNED < 0.05 & !is.na(POP_ALIGNED) & POP_ALIGNED > 1, 1, NA)
elim_mask  <- mask(elim_mask, ADMIN0_A)
ELIM_AREA  <- as.numeric(global(mask(CELL_AREA_KM2, elim_mask), "sum", na.rm=TRUE)[1,1])
saveRDS(ELIM_AREA, file.path(data_dir, "elim_area.rds"))
cat("  Saved: elim_area.rds\n")
# ── Step 7: Save global burden for UC2 ───────────────────────
cat("Step 7: Saving global burden...\n")
bur_mask  <- ifel(!is.na(INC_ALIGNED) & !is.na(POP_ALIGNED) &
POP_ALIGNED > 0 & INC_ALIGNED > 1e-12, 1, NA)
bur_valid  <- mask(BURDEN_GLOBAL, bur_mask)
bur_valid  <- mask(bur_valid, ADMIN0_A)
AFRO_BUR   <- as.numeric(global(bur_valid, "sum", na.rm=TRUE)[1,1])
saveRDS(AFRO_BUR, file.path(data_dir, "afro_burden.rds"))
cat("  Saved: afro_burden.rds\n")
cat("\n✓ All pre-processing complete!\n")
cat("New files in data/ folder:\n")
new_files <- c("boundaries.rds",
"pfpr_aligned.tif", "itn_aligned.tif",
"burden_aligned.tif", "cell_area_km2.tif",
paste0(sp_names, "_aligned.tif"),
paste0("tier_uc1a_", sp_names, ".tif"),
paste0("tier_uc1b_", sp_names, ".tif"),
paste0("tier_uc2_",  sp_names, ".tif"),
paste0("tier_uc3_",  sp_names, ".tif"),
"elim_area.rds", "afro_burden.rds")
cat(paste(" -", new_files, collapse="\n"), "\n")
cat("\nYou can now deploy the Shiny apps to shinyapps.io\n")
bounds <- readRDS("data/boundaries.rds")
names(bounds)
# Should show: ADMIN0_sf ADMIN1_sf AFRICA0_sf AFRICA1_sf COUNTRY_CHOICES afro_sf
nrow(bounds$ADMIN0_sf)
# Should show a number > 0
ADMIN0_A <- vect(bounds$ADMIN0_sf)
cat("ADMIN0_A extent:", as.character(ext(ADMIN0_A)), "\n")
runApp('Demo_trial_1a.R')
